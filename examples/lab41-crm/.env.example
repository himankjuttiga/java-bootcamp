# Lab 41 — runtime config example (copy to .env locally; never commit .env)
# Names align with the docker Spring profile (application-docker.yml) and SecurityConfig agents.

CRM_DB_HOST=crm-postgres
CRM_DB_PORT=5432
CRM_DB_NAME=crm_lab40
CRM_DB_USER=crm
CRM_DB_PASSWORD=change-me-locally
CRM_AGENT_A_PASSWORD=change-me-locally
CRM_AGENT_B_PASSWORD=change-me-locally
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
